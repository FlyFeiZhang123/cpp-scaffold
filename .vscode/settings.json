{
  "editor.formatOnSave": true,
  // 构建统一走 ./my_build.bash（Ninja + ASAN → build/debug-asan/，build/ 根上是软链）。
  // CMake Tools 只用来给 CMakeLists.txt 提供语法高亮和补全，不参与构建。
  // configureOnOpen 之前是 true —— 每次打开文件夹都会自动 configure 出一套
  // build/Debug（Makefiles、无 ASAN）并弹提示，已关掉。
  // 下面两行在 CMakePresets 模式下本来就被忽略，且插件默认值就是 build/，删不删一样。
  "cmake.configureOnOpen": false,
  "cmake.buildDirectory": "${workspaceFolder}/build",
  "cmake.generator": "Ninja",
  "cmake.configureSettings": {
    "CMAKE_EXPORT_COMPILE_COMMANDS": true
  },
  "cmake.sourceDirectory": "${workspaceFolder}",
  "cmake.ignoreCMakeListsMissing": true,
  "files.associations": {
    "*.h": "cpp"
  },
  "clangd.path": "/usr/bin/clangd",
  "clangd.arguments": [
    "--background-index",
    "--compile-commands-dir=${workspaceFolder}/build",
    "--query-driver=/usr/bin/clang*,/usr/bin/gcc*",
    "--header-insertion=never",
    "--clang-tidy",
    "--completion-style=detailed"
  ],
  "[cpp]": {
    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
  },
  "[c]": {
    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
  },
  "logViewer.watch": [
    {
      "title": "Test Logs",
      "pattern": "out/logs/**/*.log"
    }
  ]
}
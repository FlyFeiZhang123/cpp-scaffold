{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug (普通)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/__EXECUTABLE_NAME__",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "preLaunchTask": "my_build",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Debug (sudo / root)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/__EXECUTABLE_NAME__",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "${workspaceFolder}/.vscode/sudo_gdb.sh",
            "preLaunchTask": "my_build",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}

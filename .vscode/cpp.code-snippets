{
  "header guard": {
    "prefix": "once",
    "body": [
      "#pragma once",
      "",
      "$0"
    ],
    "description": "Insert #pragma once"
  },
  "class with ctor/dtor": {
    "prefix": "classdef",
    "body": [
      "class ${1:ClassName} {",
      "public:",
      "    ${1:ClassName}()  = default;",
      "    ~${1:ClassName}() = default;",
      "",
      "    ${1:ClassName}(const ${1:ClassName}&)            = default;",
      "    ${1:ClassName}& operator=(const ${1:ClassName}&) = default;",
      "    ${1:ClassName}(${1:ClassName}&&)                 = default;",
      "    ${1:ClassName}& operator=(${1:ClassName}&&)      = default;",
      "",
      "private:",
      "    $0",
      "};"
    ],
    "description": "Class with rule-of-five defaults"
  },
  "class with custom ctor/dtor (no copy)": {
    "prefix": "classmove",
    "body": [
      "class ${1:ClassName} {",
      "public:",
      "    ${1:ClassName}()  = default;",
      "    ~${1:ClassName}() = default;",
      "",
      "    ${1:ClassName}(const ${1:ClassName}&)            = delete;",
      "    ${1:ClassName}& operator=(const ${1:ClassName}&) = delete;",
      "    ${1:ClassName}(${1:ClassName}&&)                 = default;",
      "    ${1:ClassName}& operator=(${1:ClassName}&&)      = default;",
      "",
      "private:",
      "    $0",
      "};"
    ],
    "description": "Move-only class (copy deleted)"
  },
  "include system": {
    "prefix": "inc",
    "body": [
      "#include <${1:header}>$0"
    ],
    "description": "#include <...>"
  },
  "include local": {
    "prefix": "incl",
    "body": [
      "#include \"${1:header}\"$0"
    ],
    "description": "#include \"...\""
  },
  "for loop indexed": {
    "prefix": "cfori",
    "body": [
      "for (int ${1:i} = 0; ${1:i} < ${2:n}; ++${1:i}) {",
      "    $0",
      "}"
    ],
    "description": "Indexed for loop"
  }
}
